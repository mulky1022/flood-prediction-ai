# Supabase PostgreSQL Configuration
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Open-Meteo API Settings (no key required — free public API)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT=20.0
OPEN_METEO_MAX_RETRIES=2

# Map Configuration (100% Free Open-Source OpenStreetMap & HOT, no keys required)

# Application & CORS Settings
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8000
APP_ENV=production
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0
