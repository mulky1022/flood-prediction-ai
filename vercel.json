{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "tests/**|docs/**|.github/**|scripts/**|frontend/stitch*/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/district", "destination": "/district.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/alerts", "destination": "/alerts.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/emergency", "destination": "/emergency.html" }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/monitor",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(css|js)/(.+)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
